---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { defaultLang, languages, locales, useTranslations } from '../i18n';
// Fuentes autoalojadas (@fontsource), subconjunto latin, solo los pesos usados
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';

interface Props {
  title?: string;
  description?: string;
  /** La página existe en todos los idiomas: emite canonical y hreflang. */
  alternates?: boolean;
}

const { lang, t } = useTranslations(Astro.currentLocale);
const {
  title = t('meta.defaultTitle'),
  description = t('meta.description'),
  alternates = false,
} = Astro.props;

const canonicalUrl = alternates ? getAbsoluteLocaleUrl(lang, '') : new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL('/assets/images/og-image.png', Astro.site).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Patrón Gómez',
  url: new URL('/', Astro.site).href,
  image: ogImageUrl,
  jobTitle: 'Front-End Developer',
  sameAs: [
    'https://www.linkedin.com/in/dpatrongomez/',
    'https://github.com/dpatrongomez',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Daniel Patrón Gómez" />
    <meta name="keywords" content="Daniel Patron Gomez, dpatrongomez, Desarrollador, Flutter, Angular, Android, Web, Portfolio, Guadalajara" />

    <link rel="canonical" href={canonicalUrl} />

    <!-- Idiomas: hreflang solo en las páginas con versión en cada idioma -->
    {alternates && (
      <>
        {locales.map((code) => (
          <link rel="alternate" hreflang={code} href={getAbsoluteLocaleUrl(code, '')} />
        ))}
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLang, '')} />
      </>
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Daniel Patrón Gómez - Front-End Developer" />
    <meta property="og:url" content={canonicalUrl} />

    <meta property="og:locale" content={languages[lang].ogLocale} />
    {alternates &&
      locales
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={languages[code].ogLocale} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD: Person -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  </head>
  <body>
    <a href="#main-content" class="skip-link">{t('nav.skip')}</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 8px;
    z-index: 2000;
    padding: 8px 16px;
    background: var(--text-display);
    color: var(--bg-main);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
  }

  .skip-link:focus {
    top: 8px;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
