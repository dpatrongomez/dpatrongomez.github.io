---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { defaultLang, languages, locales, useTranslations } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** La página existe en todos los idiomas: emite canonical y hreflang. */
  alternates?: boolean;
}

const { lang, t } = useTranslations(Astro.currentLocale);
const {
  title = t('meta.defaultTitle'),
  description = t('meta.description'),
  alternates = false,
} = Astro.props;

const canonicalUrl = alternates ? getAbsoluteLocaleUrl(lang, '') : new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL('/assets/images/og-image.png', Astro.site).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Patrón Gómez',
  url: new URL('/', Astro.site).href,
  image: ogImageUrl,
  jobTitle: 'Front-End Developer',
  sameAs: [
    'https://www.linkedin.com/in/dpatrongomez/',
    'https://github.com/dpatrongomez',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Daniel Patrón Gómez" />
    <meta name="keywords" content="Daniel Patron Gomez, dpatrongomez, Desarrollador, Flutter, Angular, Android, Web, Portfolio, Guadalajara" />

    <link rel="canonical" href={canonicalUrl} />

    <!-- Idiomas: hreflang solo en las páginas con versión en cada idioma -->
    {alternates && (
      <>
        {locales.map((code) => (
          <link rel="alternate" hreflang={code} href={getAbsoluteLocaleUrl(code, '')} />
        ))}
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLang, '')} />
      </>
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Daniel Patrón Gómez - Front-End Developer" />
    <meta property="og:url" content={canonicalUrl} />

    <meta property="og:locale" content={languages[lang].ogLocale} />
    {alternates &&
      locales
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={languages[code].ogLocale} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD: Person -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Google Fonts: Inter, Space Grotesk & Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 7.3.0 & Devicon Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
