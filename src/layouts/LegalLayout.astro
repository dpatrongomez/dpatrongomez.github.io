---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  appName?: string;
}

const { title, appName = 'Pluggy' } = Astro.props;
---

<Layout title={`${title} - ${appName}`}>
  <nav class="legal-nav glass-panel">
    <div class="container nav-content">
      <a href="/" class="back-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Volver a inicio</span>
      </a>
      <div class="app-badge">
        <i class="fa-solid fa-charging-station"></i>
        <span>{appName}</span>
      </div>
    </div>
  </nav>

  <main class="legal-main">
    <article class="legal-card container">
      <slot />
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .legal-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--card-border);
    padding: 16px 24px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 900px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--navy-accent);
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition);
  }

  .back-link:hover {
    color: var(--primary);
    transform: translateX(-3px);
  }

  .app-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--primary-light);
    color: var(--primary-hover);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .legal-main {
    padding: 40px 20px 80px;
    background-color: var(--body-bg);
    min-height: calc(100vh - 140px);
  }

  .legal-card {
    max-width: 900px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 48px;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 768px) {
    .legal-card {
      padding: 24px 18px;
    }
  }
</style>

<style is:global>
  /* Markdown styling inside legal-card */
  .legal-card h1 {
    font-size: 2rem;
    color: var(--navy-accent);
    margin-bottom: 12px;
    border-bottom: 3px solid var(--primary);
    padding-bottom: 12px;
  }

  .legal-card h2 {
    font-size: 1.35rem;
    color: var(--navy-accent);
    margin-top: 36px;
    margin-bottom: 16px;
  }

  .legal-card h3 {
    font-size: 1.1rem;
    color: var(--text-main);
    margin-top: 24px;
    margin-bottom: 10px;
  }

  .legal-card p {
    color: var(--text-main);
    line-height: 1.7;
    margin-bottom: 16px;
    font-size: 0.98rem;
  }

  .legal-card strong {
    color: var(--navy-dark);
  }

  .legal-card hr {
    border: none;
    border-top: 1px solid var(--card-border);
    margin: 32px 0;
  }

  .legal-card ul, .legal-card ol {
    margin-bottom: 20px;
    padding-left: 24px;
    list-style-type: disc;
  }

  .legal-card li {
    margin-bottom: 8px;
    color: var(--text-main);
    line-height: 1.6;
  }

  .legal-card code {
    background: #f1f5f9;
    color: #e11d48;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.9em;
  }

  .legal-card a {
    color: var(--primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .legal-card a:hover {
    color: var(--primary-hover);
  }
</style>
