---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  appName?: string;
}

const { title, appName = 'Pluggy' } = Astro.props;
---

<Layout title={`${title} - ${appName}`}>
  <nav class="legal-nav">
    <div class="container nav-content">
      <a href="/" class="back-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Volver a inicio</span>
      </a>
      <div class="app-badge">
        <i class="fa-solid fa-charging-station"></i>
        <span>{appName}</span>
      </div>
    </div>
  </nav>

  <main class="legal-main">
    <article class="legal-card container">
      <slot />
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .legal-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    padding: 14px 24px;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 850px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-display);
    font-size: 0.88rem;
    font-weight: 500;
    transition: var(--transition);
  }

  .back-link:hover {
    color: var(--accent);
    transform: translateX(-3px);
  }

  .app-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-display);
    font-family: var(--font-mono);
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
  }

  .legal-main {
    padding: 40px 20px 80px;
    background-color: var(--bg-main);
    min-height: calc(100vh - 140px);
  }

  .legal-card {
    max-width: 850px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 40px;
  }

  @media (max-width: 768px) {
    .legal-card {
      padding: 24px 18px;
    }
  }
</style>

<style is:global>
  /* Markdown styling inside legal-card */
  .legal-card h1 {
    font-size: 2rem;
    color: var(--text-display);
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 16px;
    font-weight: 700;
  }

  .legal-card h2 {
    font-size: 1.35rem;
    color: var(--text-display);
    margin-top: 32px;
    margin-bottom: 14px;
    font-weight: 600;
  }

  .legal-card h3 {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .legal-card p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 16px;
    font-size: 0.95rem;
  }

  .legal-card strong {
    color: var(--text-display);
  }

  .legal-card hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 28px 0;
  }

  .legal-card ul, .legal-card ol {
    margin-bottom: 20px;
    padding-left: 20px;
    list-style-type: disc;
  }

  .legal-card li {
    margin-bottom: 8px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .legal-card code {
    background: var(--bg-surface);
    color: var(--accent);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.88em;
    border: 1px solid var(--border);
  }

  .legal-card a {
    color: var(--text-display);
    text-decoration: underline;
    font-weight: 500;
  }

  .legal-card a:hover {
    color: var(--accent);
  }
</style>
