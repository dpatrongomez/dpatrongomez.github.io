---
import { existsSync, readFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";

import { useTranslations, type Lang } from "../i18n";
import {
  buildTokenUsage,
  compact,
  formatDayRange,
  parseUsageRows,
  type UsageRow,
} from "../lib/token-usage";

const { lang, t } = useTranslations(Astro.currentLocale);

/* -------------------------------------------------------------------------- */
/* Carga de datos (build time). Cualquier fallo => estado vacío, nunca throw.  */
/* -------------------------------------------------------------------------- */

const DATA_RELATIVE_PATH = join("public", "data", "token-usage.json");
const PROJECT_ROOT_MARKERS = ["astro.config.mjs", "astro.config.ts", "astro.config.js"];

/**
 * Localiza el archivo de datos anclando en la raíz del proyecto Astro.
 *
 * No se puede anclar en la URL del módulo: en `astro build` Vite empaqueta
 * este componente dentro de `dist/`, así que `../../` apuntaría a
 * `dist/public/data/...`, que no existe (Astro copia `public/` a la raíz de
 * `dist/`). Se sube desde el cwd hasta encontrar `astro.config.*` o el propio
 * archivo, y si no se encuentra nada se cae a la ruta relativa al cwd.
 */
function findDataPath(): string {
  let dir = process.cwd();
  for (;;) {
    for (const marker of [...PROJECT_ROOT_MARKERS, DATA_RELATIVE_PATH]) {
      if (existsSync(join(dir, marker))) return join(dir, DATA_RELATIVE_PATH);
    }
    const parent = dirname(dir);
    if (parent === dir) break;
    dir = parent;
  }
  return resolve(process.cwd(), DATA_RELATIVE_PATH);
}

function loadRows(lang: Lang): UsageRow[] {
  try {
    const parsed: unknown = JSON.parse(readFileSync(findDataPath(), "utf8"));
    return parseUsageRows(parsed, lang);
  } catch (error) {
    const reason = error instanceof Error ? error.message : String(error);
    console.warn(`[TokenUsage] No se pudieron cargar los datos de consumo de tokens (${reason}). Se renderiza el estado vacío.`);
    return [];
  }
}

/* -------------------------------------------------------------------------- */
/* Derivados: la lógica vive en `src/lib/token-usage.ts`, aquí solo se        */
/* adaptan sus exports a los nombres que usa la plantilla.                    */
/* -------------------------------------------------------------------------- */

const usage = buildTokenUsage(loadRows(lang), lang);

const hasData = usage.hasData;

const minDay = usage.minDay;
const maxDay = usage.maxDay;

const topModels = usage.topModels;
const topTokens = usage.topTokens;

const dailySeries = usage.dailySeries;
const monthlySeries = usage.monthlySeries;
const monthlyRangeLabel = usage.monthlyRangeLabel;

const dailyChart = usage.dailyChart;
const monthlyChart = usage.monthlyChart;
const dailyAria = usage.dailyAria;
const monthlyAria = usage.monthlyAria;

const updatedAt = usage.updatedAt;
---
<section id="tokens" data-tokens-root>
  <div class="container">
    <div class="section-tag">
      <i class="fa-solid fa-microchip text-muted"></i> {t('tokens.label')}
    </div>
    <h2 class="section-title">{t('tokens.title')}</h2>
    <div class="section-divider"></div>

    {!hasData ? (
      <div class="tokens-empty">
        <i class="fa-solid fa-chart-column"></i>
        <p>{t('tokens.empty')}</p>
      </div>
    ) : (
      <>
        <div class="panel">
          <div class="panel-head">
            <h3 class="panel-title">{t('tokens.panelTitle')}</h3>
            <div class="range-toggle" role="group" aria-label={t('tokens.rangeLabel')}>
              <button type="button" class="range-btn" data-range="day" aria-pressed="true">{t('tokens.daily')}</button>
              <button type="button" class="range-btn" data-range="month" aria-pressed="false">{t('tokens.monthly')}</button>
            </div>
          </div>

          {/*
            Las dos vistas comparten marcado: solo cambian el panel, la
            geometría, la leyenda y el pie. La leyenda solo existe en la vista
            diaria porque es la única que dibuja la línea de media. Ninguna
            vista llega marcada como `hidden`: sin JS se ven las dos, y el
            script fija el estado inicial al mejorar la vista.
          */}
          {[
            {
              panel: "day",
              chart: dailyChart,
              aria: dailyAria,
              caption: t("tokens.captionDaily", {
                count: dailySeries.length,
                range: formatDayRange(minDay, maxDay, lang),
              }),
              legend: true,
            },
            {
              panel: "month",
              chart: monthlyChart,
              aria: monthlyAria,
              caption: t("tokens.captionMonthly", { count: monthlySeries.length, range: monthlyRangeLabel }),
              legend: false,
            },
          ].map((view) => (
            <div class="chart-view" data-panel={view.panel}>
              {view.legend && (
                <ul class="chart-legend">
                  <li class="legend-item">
                    <span class="legend-swatch is-bar" aria-hidden="true"></span>
                    {t('tokens.legendDaily')}
                  </li>
                  <li class="legend-item">
                    <span class="legend-swatch is-line" aria-hidden="true"></span>
                    {t('tokens.legendAverage')}
                  </li>
                </ul>
              )}

              {view.chart && (
                <svg
                  viewBox={`0 0 ${view.chart.width} ${view.chart.height}`}
                  width="100%"
                  class="chart-svg"
                  role="img"
                  aria-label={view.aria}
                >
                  {view.chart.grid.map((line) => (
                    <>
                      <line
                        class="chart-grid-line"
                        x1={view.chart.plotLeft}
                        y1={line.y}
                        x2={view.chart.width - view.chart.plotRight}
                        y2={line.y}
                      />
                      <text class="chart-axis-label" x={view.chart.plotLeft - 10} y={line.y + 4} text-anchor="end">
                        {line.label}
                      </text>
                    </>
                  ))}

                  {/* Un día sin filas no dibuja barra: el hueco es el dato.
                      Solo la vista mensual envuelve cada barra en un grupo con
                      su valor encima al hover, como la etiqueta del pico. */}
                  {view.chart.bars.map((bar) =>
                    view.panel === "month" ? (
                      <g
                        class={
                          view.chart.partialMarker &&
                          Math.abs(bar.x + bar.w / 2 - view.chart.partialMarker.x) < 0.01
                            ? "chart-bar-group is-partial"
                            : "chart-bar-group"
                        }
                      >
                        <rect class={bar.zero ? "chart-bar is-zero" : "chart-bar"} x={bar.x} y={bar.y} width={bar.w} height={bar.h} rx="2">
                          <title>{bar.title}</title>
                        </rect>
                        <text class="chart-hover-label" x={bar.x + bar.w / 2} y={bar.y - 8} text-anchor="middle">
                          {bar.hover}
                        </text>
                        {view.chart.partialMarker &&
                          Math.abs(bar.x + bar.w / 2 - view.chart.partialMarker.x) < 0.01 && (
                            <text
                              class="chart-partial-glyph"
                              x={view.chart.partialMarker.x}
                              y={view.chart.partialMarker.y}
                              text-anchor="middle"
                            >
                              <title>
                                {view.chart.partialMarker.label} ({view.chart.partialMarker.coverage})
                              </title>
                              {"\uF254"}
                            </text>
                          )}
                      </g>
                    ) : (
                      <rect class={bar.zero ? "chart-bar is-zero" : "chart-bar"} x={bar.x} y={bar.y} width={bar.w} height={bar.h} rx="2">
                        <title>{bar.title}</title>
                      </rect>
                    ),
                  )}

                  {view.chart.labels.map((label) => (
                    <text class="chart-axis-label" x={label.x} y={view.chart.height - 14} text-anchor="middle">
                      {label.text}
                    </text>
                  ))}

                  {/*
                    Un `<path>` por tramo: unir los tramos en un solo `d`
                    tendería una recta por encima del hueco y lo leería como
                    consumo.
                  */}
                  {view.chart.line.map((segment) => (
                    <path
                      class="chart-line"
                      d={segment.points.map((point, index) => `${index === 0 ? "M" : "L"}${point.x} ${point.y}`).join(" ")}
                    />
                  ))}

                  {view.chart.peakLabel && (
                    <text class="chart-peak-label" x={view.chart.peakLabel.x} y={view.chart.peakLabel.y} text-anchor="middle">
                      {view.chart.peakLabel.text}
                    </text>
                  )}

                  {/*
                    El reloj de arena marca la barra del periodo sin cerrar; su
                    cobertura solo vive en el tooltip, igual que la del resto de
                    periodos parciales. `U+F254` es `fa-hourglass` en la fuente
                    de FontAwesome 7 (peso 900).
                  */}
                  {view.chart.partialMarker && view.panel !== "month" && (
                    <g>
                      <title>
                        {view.chart.partialMarker.label} ({view.chart.partialMarker.coverage})
                      </title>
                      <text
                        class="chart-partial-glyph"
                        x={view.chart.partialMarker.x}
                        y={view.chart.partialMarker.y}
                        text-anchor="middle"
                      >{"\uF254"}</text>
                    </g>
                  )}
                </svg>
              )}

              <p class="chart-caption">{view.caption}</p>
            </div>
          ))}
        </div>

        <div class="panel">
          <h3 class="panel-title">{t('tokens.topModels')}</h3>
          <ol class="model-list">
            {topModels.map((model) => (
              <li class="model-row">
                <span class="model-name">{model.label}</span>
                <span class="model-bar" aria-hidden="true">
                  <span
                    class="model-bar-fill"
                    style={`width: ${topTokens > 0 ? Math.max(2, (model.tokens / topTokens) * 100) : 0}%`}
                  ></span>
                </span>
                <span class="model-tokens">{compact(model.tokens, lang)}</span>
              </li>
            ))}
          </ol>
        </div>

        <p class="tokens-updated">{t('tokens.updated', { date: updatedAt })}</p>
      </>
    )}
  </div>
</section>

<style>
  .tokens-empty {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    text-align: center;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .tokens-empty i {
    color: var(--text-muted);
  }

  .panel {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
  }

  .panel + .panel {
    margin-top: var(--space-lg);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .panel-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-display);
    margin: 0 0 12px;
  }

  .panel-head .panel-title {
    margin: 0;
  }

  /* El conmutador solo se muestra cuando el script puede accionarlo. */
  .range-toggle {
    display: none;
    gap: 4px;
    padding: 3px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  [data-tokens-enhanced] .range-toggle {
    display: inline-flex;
  }

  .range-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    cursor: pointer;
    transition: var(--transition);
  }

  .range-btn:hover {
    color: var(--text-display);
  }

  .range-btn[aria-pressed="true"] {
    background: var(--accent-subtle);
    color: var(--accent-hover);
  }

  /* Sin JS las dos vistas se ven; el script revela el conmutador y reactiva
     esta regla para que solo quede la que ha pulsado el visitante. */
  [data-tokens-enhanced] .chart-view[hidden] {
    display: none;
  }

  .chart-view + .chart-view {
    margin-top: var(--space-md);
  }

  /* Solo la vista diaria lleva línea de media, así que solo ella lleva leyenda. */
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0 0 var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .legend-swatch {
    display: block;
    flex: none;
    border-radius: 2px;
  }

  .legend-swatch.is-bar {
    width: 9px;
    height: 9px;
    background: var(--accent);
    opacity: 0.85;
  }

  .legend-swatch.is-line {
    width: 18px;
    height: 2px;
    background: var(--text-muted);
    border-radius: var(--radius-full);
  }

  .chart-svg {
    display: block;
    width: 100%;
    height: auto;
    /* La anotación del pico sube de `PLOT_TOP`: sin esto, el texto se recorta. */
    overflow: visible;
  }

  .chart-view :global(.chart-grid-line) {
    stroke: var(--border);
    stroke-width: 1;
  }

  .chart-view :global(.chart-axis-label) {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .chart-view :global(.chart-bar) {
    fill: var(--accent);
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }

  .chart-view :global(.chart-bar:hover) {
    opacity: 1;
  }

  /* Filas que suman cero: stub visible, no ausencia. */
  .chart-view :global(.chart-bar.is-zero) {
    fill: var(--border-hover);
    opacity: 1;
  }

  .chart-view :global(.chart-line) {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chart-view :global(.chart-peak-label) {
    fill: var(--text-display);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* Valor de cada barra mensual, oculto hasta el hover del grupo. */
  .chart-view :global(.chart-hover-label) {
    fill: var(--text-display);
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .chart-view :global(.chart-bar-group:hover .chart-hover-label) {
    opacity: 1;
  }

  .chart-view :global(.chart-bar-group.is-partial:hover .chart-partial-glyph) {
    opacity: 0;
  }

  .chart-view :global(.chart-partial-glyph) {
    fill: var(--accent);
    font-family: "Font Awesome 7 Free";
    font-weight: 900;
    font-size: 12px;
    opacity: 1;
    transition: opacity 0.15s ease;
    /* Halo del fondo de la tarjeta: separa el glifo de la barra (mismo
       `accent`) y le da contraste sobre el fondo oscuro. */
    stroke: var(--bg-card);
    stroke-width: 3px;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .chart-caption {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  /* Una fila por modelo: etiqueta, barra y valor en la misma línea. */
  .model-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .model-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(90px, 2fr) auto;
    align-items: center;
    gap: var(--space-md);
  }

  .model-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .model-bar {
    display: block;
    height: 4px;
    background: var(--bg-surface);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .model-bar-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: var(--radius-full);
  }

  .model-tokens {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-display);
    text-align: right;
    white-space: nowrap;
  }

  .tokens-updated {
    margin-top: var(--space-lg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }
</style>

<script>
  /*
   * Mejora progresiva: el HTML llega con las dos vistas visibles y sin el
   * conmutador (nada de lo que hay en la página depende de este script). Al
   * arrancar, el script marca la raíz como mejorada —lo que revela el
   * conmutador y reactiva la regla `[hidden]`— y aplica el estado inicial.
   */
  const roots = document.querySelectorAll('[data-tokens-root]');

  roots.forEach((root) => {
    const buttons = root.querySelectorAll('.range-btn');
    const panels = root.querySelectorAll('.chart-view');

    if (buttons.length === 0) return;

    root.setAttribute('data-tokens-enhanced', '');

    const select = (range) => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.getAttribute('data-range') === range));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute('data-panel') !== range;
      });
    };

    select('day');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        select(button.getAttribute('data-range'));
      });
    });
  });
</script>