---
const experiences = [
  {
    company: "BBVA Technology en Europa",
    location: "Madrid, Comunidad de Madrid, España",
    period: "4 años 9 meses",
    type: "Jornada completa",
    logo: "/assets/images/companies/bbva.webp",
    icon: "fa-building-columns",
    roles: [
      {
        title: "Front-end Developer",
        date: "ene. 2025 - actualidad · 1 año 8 meses",
        workplace: "Híbrido",
        description: "Desarrollador front-end en la aplicación móvil de banca de BBVA Italia y Alemania.",
        skills: ["Ember.js", "JavaScript", "Banca Móvil"]
      },
      {
        title: "Front-end Developer",
        date: "ene. 2024 - ene. 2025 · 1 año 1 mes",
        workplace: "Híbrido",
        description: "Desarrollador front-end en la aplicación móvil de banca de BBVA España migrando la tecnología de la aplicación.",
        skills: ["Web Components", "Lit", "Migración Tecnológica"]
      },
      {
        title: "Front-end Developer",
        date: "dic. 2021 - ene. 2024 · 2 años 2 meses",
        workplace: "Híbrido",
        description: "Desarrollador front-end en la aplicación móvil de banca de BBVA España haciendo uso de Ember.js como framework.",
        skills: ["Ember.js", "Metodologías Ágiles", "Front-end"]
      }
    ]
  },
  {
    company: "Azonix Tec",
    location: "Guadalajara, España",
    period: "2018 - 2021",
    type: "Jornada parcial / Temporal",
    logo: "/assets/images/companies/azonix.webp",
    icon: "fa-network-wired",
    roles: [
      {
        title: "Responsable de proyectos",
        date: "nov. 2021 - dic. 2021 · 2 meses",
        workplace: "Jornada parcial",
        description: "Gestión, coordinación y supervisión de proyectos informáticos y de telecomunicaciones.",
        skills: ["Gestión de Proyectos", "Coordinación"]
      },
      {
        title: "Desarrollador y Técnico de Telecomunicaciones e Informática",
        date: "jul. 2020 - dic. 2021 · 1 año 6 meses",
        workplace: "Jornada parcial",
        description: "Desarrollo de software y mantenimiento técnico de infraestructuras informáticas y de redes.",
        skills: ["Desarrollo Software", "Sistemas", "Redes"]
      },
      {
        title: "Técnico de Telecomunicaciones e Informática",
        date: "may. 2019 - sept. 2019 · 5 meses",
        workplace: "Contrato temporal",
        description: "Mantenimiento e instalación de infraestructura de telecomunicaciones e informática.",
        skills: ["Telecomunicaciones", "Sistemas"]
      },
      {
        title: "Técnico de Telecomunicaciones e Informática",
        date: "abr. 2018 - nov. 2018 · 8 meses",
        workplace: "Contrato temporal",
        description: "Soporte técnico, configuración de equipos informáticos y mantenimiento de red.",
        skills: ["Soporte Técnico", "Redes"]
      }
    ]
  }
];

function getSkillData(skillName: string) {
  const lower = skillName.toLowerCase();
  if (lower.includes("ember")) return { icon: "fa-brands fa-ember" };
  if (lower.includes("javascript") || lower.includes("js")) return { icon: "fa-brands fa-js" };
  if (lower.includes("lit")) return { svg: `<svg viewBox="0 0 24 24" class="skill-svg-ic" fill="currentColor"><path d="M6.719 0l5.485 5.485-2.743 2.743 5.486 5.486-2.743 2.743 8.228 8.229-5.485 5.485-10.971-10.971 2.742-2.743-5.485-5.486 2.743-2.743L6.719 0z"/></svg>` };
  if (lower.includes("web components")) return { svg: `<svg viewBox="0 0 24 24" class="skill-svg-ic" fill="currentColor"><path d="M12 0l-5.196 3v6L1.608 12 12 18l10.392-6-5.196-3V3L12 0zm0 2.309l3.196 1.845v3.691L12 9.691 8.804 7.845V4.154L12 2.309zM3.608 12.845l3.196 1.846v3.691L3.608 16.537v-3.692zm16.784 0v3.692L17.196 18.382v-3.691l3.196-1.846z"/></svg>` };
  if (lower.includes("flutter")) return { icon: "fa-brands fa-flutter" };
  if (lower.includes("dart")) return { icon: "fa-brands fa-dart-lang" };
  if (lower.includes("android")) return { icon: "fa-brands fa-android" };
  if (lower.includes("angular")) return { icon: "fa-brands fa-angular" };
  if (lower.includes("banca")) return { icon: "fa-solid fa-building-columns" };
  if (lower.includes("migración") || lower.includes("migracion")) return { icon: "fa-solid fa-arrow-right-arrow-left" };
  if (lower.includes("front-end") || lower.includes("desarrollo software")) return { icon: "fa-solid fa-code" };
  if (lower.includes("ágil") || lower.includes("agile") || lower.includes("scrum")) return { icon: "fa-solid fa-diagram-project" };
  if (lower.includes("gestión") || lower.includes("gestion") || lower.includes("coordinación") || lower.includes("coordinacion")) return { icon: "fa-solid fa-list-check" };
  if (lower.includes("telecomunicaciones")) return { icon: "fa-solid fa-tower-broadcast" };
  if (lower.includes("sistemas")) return { icon: "fa-solid fa-server" };
  if (lower.includes("redes") || lower.includes("red")) return { icon: "fa-solid fa-network-wired" };
  if (lower.includes("soporte")) return { icon: "fa-solid fa-headset" };
  return { icon: "fa-solid fa-circle-check" };
}
---

<section id="experience">
  <div class="container">
    <div class="section-tag">
      <i class="fa-solid fa-briefcase text-muted"></i> EXPERIENCIA
    </div>
    <h2 class="section-title">Experiencia laboral</h2>
    <div class="section-divider"></div>

    <div class="experience-feed">
      {experiences.map((companyGroup) => (
        <div class="company-card">
          <!-- Header de la Empresa -->
          <div class="company-header">
            <div class="company-logo-box">
              {companyGroup.logo ? (
                <img src={companyGroup.logo} alt={`Logo ${companyGroup.company}`} class="company-logo-img" />
              ) : (
                <i class={`fa-solid ${companyGroup.icon}`}></i>
              )}
            </div>
            <div class="company-details">
              <div class="company-title-row">
                <h3 class="company-name">{companyGroup.company}</h3>
                <span class="company-period-badge">
                  <i class="fa-regular fa-clock"></i> {companyGroup.period}
                </span>
              </div>
              <p class="company-meta">
                <span><i class="fa-solid fa-location-dot"></i> {companyGroup.location}</span>
                <span class="bullet-dot">•</span>
                <span><i class="fa-solid fa-briefcase"></i> {companyGroup.type}</span>
              </p>
            </div>
          </div>

          <!-- Roles dentro de la Empresa -->
          <div class="roles-timeline">
            {companyGroup.roles.map((role, idx) => (
              <div class="role-item">
                <div class="role-node">
                  <div class="node-dot"></div>
                  {idx < companyGroup.roles.length - 1 && <div class="node-line"></div>}
                </div>

                <div class="role-content">
                  <div class="role-header">
                    <div class="role-title-group">
                      <h4 class="role-title">{role.title}</h4>
                      {role.workplace && <span class="workplace-badge">{role.workplace}</span>}
                    </div>
                    <div class="role-date">
                      <i class="fa-regular fa-calendar"></i> {role.date}
                    </div>
                  </div>

                  {role.description && <p class="role-description">{role.description}</p>}

                  {role.skills && role.skills.length > 0 && (
                    <div class="role-skills">
                      {role.skills.map((skill) => {
                        const data = getSkillData(skill);
                        return (
                          <span class="skill-tag">
                            {data.svg ? (
                              <Fragment set:html={data.svg} />
                            ) : (
                              <i class={`${data.icon} skill-icon`}></i>
                            )}
                            {skill}
                          </span>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-feed {
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: 900px;
    margin: 0 auto;
  }

  .company-card {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    padding: 32px;
    transition: var(--transition);
  }

  .company-card:hover {
    border-color: var(--border-hover);
  }

  .company-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px dashed var(--border);
  }

  .company-logo-box {
    width: 52px !important;
    height: 52px !important;
    min-width: 52px !important;
    min-height: 52px !important;
    max-width: 52px !important;
    max-height: 52px !important;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
    overflow: hidden;
    padding: 0;
    box-sizing: border-box;
  }

  .company-logo-img {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  .company-details {
    flex: 1;
  }

  .company-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 6px;
  }

  .company-name {
    font-size: 1.35rem;
    color: var(--text-display);
    font-weight: 700;
  }

  .company-period-badge {
    background: var(--accent-subtle);
    color: var(--accent-hover);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--accent-border);
  }

  .company-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .bullet-dot {
    color: var(--border);
  }

  /* Roles Timeline inside company card */
  .roles-timeline {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .role-item {
    display: flex;
    gap: 20px;
    position: relative;
  }

  .role-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 20px;
    flex-shrink: 0;
    padding-top: 6px;
  }

  .node-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
    z-index: 2;
  }

  .node-line {
    width: 2px;
    flex-grow: 1;
    background: var(--border);
    margin-top: 6px;
    margin-bottom: -20px;
  }

  .role-content {
    flex: 1;
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    border: 1px solid var(--border);
    transition: var(--transition);
  }

  .role-content:hover {
    background: var(--bg-pill);
    border-color: var(--border-hover);
  }

  .role-header {
    margin-bottom: 10px;
  }

  .role-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .role-title {
    font-size: 1.1rem;
    color: var(--text-display);
    font-weight: 600;
  }

  .workplace-badge {
    background: var(--bg-main);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .role-date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .role-description {
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .role-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-tag {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-display);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: var(--transition);
  }

  .skill-tag:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface);
  }

  .skill-icon {
    font-size: 0.78rem;
    color: var(--accent-hover);
  }

  :global(.skill-svg-ic) {
    width: 12px;
    height: 12px;
    color: var(--accent-hover);
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }

  @media (max-width: 768px) {
    .company-card {
      padding: 20px 16px;
    }

    .company-header {
      gap: 14px;
    }

    .role-item {
      gap: 12px;
    }

    .role-content {
      padding: 14px 14px;
    }

    .role-title {
      font-size: 1rem;
    }
  }
</style>
