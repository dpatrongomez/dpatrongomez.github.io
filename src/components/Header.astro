---
---

<section id="header" class="hero-section">
  <div class="hero-content">
    <h1 class="hero-title">Daniel Patrón Gómez</h1>

    <div class="hero-headline">
      <span class="headline-title">Front-End Developer</span> & desarrollador de aplicaciones multiplataforma.
    </div>

    <div class="hero-typed-row">
      <span class="mono-prompt">&gt;</span>
      <span id="typed-text" class="typed-text"></span>
      <span class="cursor">|</span>
    </div>

    <p class="hero-bio">
      Actualmente en <strong>BBVA Technology en Europa</strong>, construyendo interfaces para aplicaciones móviles de banca internacional con <strong>Lit, Web Components y Ember.js</strong>. Apasionado por la arquitectura frontend, la precisión visual y las buenas prácticas.
    </p>

    <div class="hero-actions">
      <a href="#portfolio" class="btn btn-primary">
        Ver Proyectos <i class="fa-solid fa-arrow-right arrow-icon"></i>
      </a>
      <a href="#experience" class="btn btn-outline">
        Experiencia
      </a>
      <a href="https://www.linkedin.com/in/dpatrongomez/" target="_blank" rel="noopener noreferrer" class="link-social">
        LinkedIn <i class="fa-solid fa-arrow-up-right-from-square micro-icon"></i>
      </a>
      <a href="https://github.com/dpatrongomez" target="_blank" rel="noopener noreferrer" class="link-social">
        GitHub <i class="fa-solid fa-arrow-up-right-from-square micro-icon"></i>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 130px;
    padding-bottom: 60px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 780px;
  }



  .hero-title {
    font-size: 3.2rem;
    font-weight: 700;
    color: var(--text-display);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 12px;
  }

  .hero-headline {
    font-size: 1.35rem;
    color: var(--text-muted);
    font-weight: 400;
    line-height: 1.4;
    margin-bottom: 16px;
  }

  .headline-title {
    color: var(--text-display);
    font-weight: 600;
  }

  .hero-typed-row {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--accent);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: var(--radius-sm);
  }

  .mono-prompt {
    color: var(--text-muted);
  }

  .typed-text {
    color: var(--text-display);
  }

  .cursor {
    color: var(--accent);
    animation: blink 0.8s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-bio {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .hero-bio strong {
    color: var(--text-primary);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .arrow-icon {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .arrow-icon {
    transform: translateX(3px);
  }

  .link-social {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    transition: var(--transition);
  }

  .link-social:hover {
    color: var(--text-display);
    background: var(--bg-surface);
  }

  .micro-icon {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.3rem;
    }
    .hero-headline {
      font-size: 1.15rem;
    }
  }
</style>

<script>
  const words = [
    'Front-End Developer', 
    'Desarrollador Flutter & Web', 
    'Especialista en Web Components', 
    'Técnico Superior DAM'
  ];
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const typedTarget = document.getElementById('typed-text');

  function typeEffect() {
    if (!typedTarget) return;

    const currentWord = words[wordIndex];
    
    if (isDeleting) {
      typedTarget.textContent = currentWord.substring(0, charIndex - 1);
      charIndex--;
    } else {
      typedTarget.textContent = currentWord.substring(0, charIndex + 1);
      charIndex++;
    }

    let typeSpeed = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentWord.length) {
      typeSpeed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      wordIndex = (wordIndex + 1) % words.length;
      typeSpeed = 300;
    }

    setTimeout(typeEffect, typeSpeed);
  }

  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(typeEffect, 300);
  });
</script>
