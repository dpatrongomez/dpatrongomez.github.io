---
const skillCategories = [
  {
    title: "Frontend & Web",
    skills: [
      { name: "JavaScript / ES6+", icon: "fa-brands fa-js" },
      { name: "Web Components", icon: "fa-solid fa-cubes" },
      { name: "Lit", icon: "fa-solid fa-fire" },
      { name: "Ember.js", icon: "fa-solid fa-layer-group" },
      { name: "HTML5 & CSS3", icon: "fa-brands fa-html5" },
      { name: "Angular", icon: "fa-brands fa-angular" },
    ]
  },
  {
    title: "Desarrollo Mobile",
    skills: [
      { name: "Flutter", icon: "fa-solid fa-mobile-screen-button" },
      { name: "Dart", icon: "fa-solid fa-bolt" },
      { name: "Android Native", icon: "fa-brands fa-android" },
      { name: "Firebase", icon: "fa-solid fa-flame" },
      { name: "Banca Móvil", icon: "fa-solid fa-building-columns" },
    ]
  },
  {
    title: "Backend & Datos",
    skills: [
      { name: "MySQL", icon: "fa-solid fa-database" },
      { name: "REST APIs", icon: "fa-solid fa-network-wired" },
      { name: "PHP", icon: "fa-brands fa-php" },
      { name: "Python", icon: "fa-brands fa-python" },
      { name: "Java", icon: "fa-brands fa-java" },
    ]
  },
  {
    title: "Herramientas & Ágil",
    skills: [
      { name: "Git & GitHub", icon: "fa-brands fa-github" },
      { name: "GitHub Actions", icon: "fa-solid fa-gears" },
      { name: "Scrum / Agile", icon: "fa-solid fa-diagram-project" },
      { name: "Jira / Confluence", icon: "fa-solid fa-list-check" },
    ]
  }
];
---

<section id="skills">
  <div class="container">
    <div class="section-tag">
      <i class="fa-solid fa-code text-muted"></i> STACK TÉCNICO
    </div>
    <h2 class="section-title">Habilidades & Tecnologías</h2>
    <div class="section-divider"></div>

    <div class="grid-2">
      {skillCategories.map((category) => (
        <div class="skills-card">
          <h3 class="category-title">{category.title}</h3>

          <div class="chips-grid">
            {category.skills.map((skill) => (
              <div class="tech-pill">
                <i class={`${skill.icon} chip-ic`}></i>
                <span class="chip-label">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-card {
    background: var(--bg-card) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius-lg) !important;
    padding: 22px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 16px !important;
    transition: border-color 0.2s ease !important;
  }

  .skills-card:hover {
    border-color: var(--border-hover) !important;
  }

  .category-title {
    font-size: 1.05rem !important;
    color: var(--text-display) !important;
    font-weight: 600 !important;
    margin-bottom: 0 !important;
    padding-bottom: 12px !important;
    border-bottom: 1px solid var(--border) !important;
  }

  .chips-grid {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 10px !important;
  }

  .tech-pill {
    display: inline-flex !important;
    align-items: center !important;
    background: var(--bg-pill) !important;
    border: 1px solid var(--border-hover) !important;
    padding: 7px 14px !important;
    border-radius: var(--radius-sm) !important;
    color: var(--text-primary) !important;
    font-family: var(--font-sans) !important;
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    transition: var(--transition) !important;
  }

  .tech-pill:hover {
    background: var(--border) !important;
    border-color: var(--border-focus) !important;
    color: var(--text-display) !important;
  }

  .chip-ic {
    display: inline-block !important;
    font-size: 0.95rem !important;
    color: var(--accent-hover) !important;
    width: 18px !important;
    text-align: center !important;
    margin-right: 8px !important;
    flex-shrink: 0 !important;
  }

  .chip-label {
    display: inline-block !important;
  }
</style>
