---
import { Icon } from 'astro-icon/components';
const skillCategories = [
  {
    title: "Frontend & Web",
    skills: [
      { name: "JavaScript / ES6+", icon: "fa6-brands:js" },
      { 
        name: "Web Components", 
        svg: `<svg viewBox="0 0 24 24" class="chip-svg-ic" fill="currentColor"><path d="M12 0l-5.196 3v6L1.608 12 12 18l10.392-6-5.196-3V3L12 0zm0 2.309l3.196 1.845v3.691L12 9.691 8.804 7.845V4.154L12 2.309zM3.608 12.845l3.196 1.846v3.691L3.608 16.537v-3.692zm16.784 0v3.692L17.196 18.382v-3.691l3.196-1.846z"/></svg>` 
      },
      { 
        name: "Lit", 
        svg: `<svg viewBox="0 0 24 24" class="chip-svg-ic" fill="currentColor"><path d="M6.719 0l5.485 5.485-2.743 2.743 5.486 5.486-2.743 2.743 8.228 8.229-5.485 5.485-10.971-10.971 2.742-2.743-5.485-5.486 2.743-2.743L6.719 0z"/></svg>` 
      },
      { name: "Ember.js", icon: "fa6-brands:ember" },
      { name: "HTML5 & CSS3", icon: "fa6-brands:html5" },
      { name: "Angular", icon: "fa6-brands:angular" },
    ]
  },
  {
    title: "Desarrollo Mobile",
    skills: [
      { name: "Flutter", icon: "fa6-brands:flutter" },
      { name: "Dart", icon: "fa6-brands:dart-lang" },
      { name: "Android Native", icon: "fa6-brands:android" },
      { name: "Firebase", icon: "devicon-plain:firebase" },
      { name: "Banca Móvil", icon: "fa6-solid:building-columns" },
    ]
  },
  {
    title: "Backend & Datos",
    skills: [
      { name: "MySQL", icon: "devicon-plain:mysql" },
      { name: "REST APIs", icon: "fa6-solid:network-wired" },
      { name: "PHP", icon: "fa6-brands:php" },
      { name: "Python", icon: "fa6-brands:python" },
      { name: "Java", icon: "fa6-brands:java" },
    ]
  },
  {
    title: "Herramientas & Ágil",
    skills: [
      { name: "Git & GitHub", icon: "fa6-brands:git-alt" },
      { name: "GitHub Actions", icon: "devicon-plain:githubactions" },
      { name: "Scrum / Agile", icon: "fa6-solid:diagram-project" },
      { name: "Jira / Confluence", icon: "fa6-brands:jira" },
    ]
  }
];
---

<section id="skills">
  <div class="container">
    <div class="section-tag">
      <Icon name="fa6-solid:code" class="text-muted" /> STACK TÉCNICO
    </div>
    <h2 class="section-title">Habilidades & Tecnologías</h2>
    <div class="section-divider"></div>

    <div class="grid-2">
      {skillCategories.map((category) => (
        <div class="skills-card">
          <h3 class="category-title">{category.title}</h3>

          <div class="chips-grid">
            {category.skills.map((skill) => (
              <div class="tech-pill">
                {skill.svg ? (
                  <Fragment set:html={skill.svg} />
                ) : (
                  <Icon name={skill.icon} class="chip-ic" />
                )}
                <span class="chip-label">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-card {
    background: var(--bg-card) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius-lg) !important;
    padding: 22px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 16px !important;
    transition: border-color 0.2s ease !important;
  }

  .skills-card:hover {
    border-color: var(--border-hover) !important;
  }

  .category-title {
    font-size: 1.05rem !important;
    color: var(--text-display) !important;
    font-weight: 600 !important;
    margin-bottom: 0 !important;
    padding-bottom: 12px !important;
    border-bottom: 1px solid var(--border) !important;
  }

  .chips-grid {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 10px !important;
  }

  .tech-pill {
    display: inline-flex !important;
    align-items: center !important;
    background: var(--bg-pill) !important;
    border: 1px solid var(--border-hover) !important;
    padding: 7px 14px !important;
    border-radius: var(--radius-sm) !important;
    color: var(--text-primary) !important;
    font-family: var(--font-sans) !important;
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    transition: var(--transition) !important;
  }

  .tech-pill:hover {
    background: var(--border) !important;
    border-color: var(--border-focus) !important;
    color: var(--text-display) !important;
  }

  .chip-ic {
    display: inline-block !important;
    font-size: 0.95rem !important;
    color: var(--accent-hover) !important;
    width: 18px !important;
    text-align: center !important;
    margin-right: 8px !important;
    flex-shrink: 0 !important;
  }

  :global(.chip-svg-ic) {
    width: 16px !important;
    height: 16px !important;
    margin-right: 8px !important;
    color: var(--accent-hover) !important;
    flex-shrink: 0 !important;
    display: inline-block !important;
    vertical-align: middle !important;
  }

  .chip-label {
    display: inline-block !important;
  }
</style>
