---
import { localized, useTranslations } from '../i18n';

const { lang, t } = useTranslations(Astro.currentLocale);

const skillCategories = [
  {
    title: localized("Frontend & Web"),
    skills: [
      { name: localized("JavaScript / ES6+"), icon: "fa-brands fa-js" },
      {
        name: localized("Web Components"),
        svg: `<svg viewBox="0 0 24 24" class="chip-svg-ic" fill="currentColor"><path d="M12 0l-5.196 3v6L1.608 12 12 18l10.392-6-5.196-3V3L12 0zm0 2.309l3.196 1.845v3.691L12 9.691 8.804 7.845V4.154L12 2.309zM3.608 12.845l3.196 1.846v3.691L3.608 16.537v-3.692zm16.784 0v3.692L17.196 18.382v-3.691l3.196-1.846z"/></svg>`
      },
      {
        name: localized("Lit"),
        svg: `<svg viewBox="0 0 24 24" class="chip-svg-ic" fill="currentColor"><path d="M6.719 0l5.485 5.485-2.743 2.743 5.486 5.486-2.743 2.743 8.228 8.229-5.485 5.485-10.971-10.971 2.742-2.743-5.485-5.486 2.743-2.743L6.719 0z"/></svg>`
      },
      { name: localized("Ember.js"), icon: "fa-brands fa-ember" },
      { name: localized("HTML5 & CSS3"), icon: "fa-brands fa-html5" },
      { name: localized("Angular"), icon: "fa-brands fa-angular" },
    ]
  },
  {
    title: localized("Desarrollo Mobile", "Mobile Development"),
    skills: [
      { name: localized("Flutter"), icon: "fa-brands fa-flutter" },
      { name: localized("Dart"), icon: "fa-brands fa-dart-lang" },
      { name: localized("Android Native"), icon: "fa-brands fa-android" },
      { name: localized("Firebase"), icon: "devicon-firebase-plain" },
      { name: localized("Banca Móvil", "Mobile Banking"), icon: "fa-solid fa-building-columns" },
    ]
  },
  {
    title: localized("Backend & Datos", "Backend & Data"),
    skills: [
      { name: localized("MySQL"), icon: "devicon-mysql-plain" },
      { name: localized("REST APIs"), icon: "fa-solid fa-network-wired" },
      { name: localized("PHP"), icon: "fa-brands fa-php" },
      { name: localized("Python"), icon: "fa-brands fa-python" },
      { name: localized("Java"), icon: "fa-brands fa-java" },
    ]
  },
  {
    title: localized("Herramientas & Ágil", "Tools & Agile"),
    skills: [
      { name: localized("Git & GitHub"), icon: "fa-brands fa-git-alt" },
      { name: localized("GitHub Actions"), icon: "devicon-githubactions-plain" },
      { name: localized("Scrum / Agile"), icon: "fa-solid fa-diagram-project" },
      { name: localized("Jira / Confluence"), icon: "fa-brands fa-jira" },
    ]
  }
];
---

<section id="skills">
  <div class="container">
    <div class="section-tag">
      <i class="fa-solid fa-code text-muted"></i> {t('skills.label')}
    </div>
    <h2 class="section-title">{t('skills.title')}</h2>
    <div class="section-divider"></div>

    <div class="grid-2">
      {skillCategories.map((category) => (
        <div class="skills-card">
          <h3 class="category-title">{category.title[lang]}</h3>

          <div class="chips-grid">
            {category.skills.map((skill) => (
              <div class="tech-pill">
                {skill.svg ? (
                  <Fragment set:html={skill.svg} />
                ) : (
                  <i class={`${skill.icon} chip-ic`}></i>
                )}
                <span class="chip-label">{skill.name[lang]}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-card {
    background: var(--bg-card) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius-lg) !important;
    padding: 22px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 16px !important;
    transition: border-color 0.2s ease !important;
  }

  .skills-card:hover {
    border-color: var(--border-hover) !important;
  }

  .category-title {
    font-size: 1.05rem !important;
    color: var(--text-display) !important;
    font-weight: 600 !important;
    margin-bottom: 0 !important;
    padding-bottom: 12px !important;
    border-bottom: 1px solid var(--border) !important;
  }

  .chips-grid {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 10px !important;
  }

  .tech-pill {
    display: inline-flex !important;
    align-items: center !important;
    background: var(--bg-pill) !important;
    border: 1px solid var(--border-hover) !important;
    padding: 7px 14px !important;
    border-radius: var(--radius-sm) !important;
    color: var(--text-primary) !important;
    font-family: var(--font-sans) !important;
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    transition: var(--transition) !important;
  }

  .tech-pill:hover {
    background: var(--border) !important;
    border-color: var(--border-focus) !important;
    color: var(--text-display) !important;
  }

  .chip-ic {
    display: inline-block !important;
    font-size: 0.95rem !important;
    color: var(--accent-hover) !important;
    width: 18px !important;
    text-align: center !important;
    margin-right: 8px !important;
    flex-shrink: 0 !important;
  }

  :global(.chip-svg-ic) {
    width: 16px !important;
    height: 16px !important;
    margin-right: 8px !important;
    color: var(--accent-hover) !important;
    flex-shrink: 0 !important;
    display: inline-block !important;
    vertical-align: middle !important;
  }

  .chip-label {
    display: inline-block !important;
  }
</style>
