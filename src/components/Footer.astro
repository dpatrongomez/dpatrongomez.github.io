---
const currentYear = new Date().getFullYear();
---

<footer class="footer-wrapper">
  <div class="container footer-content">
    <p class="copyright-text">
      &copy; {currentYear} Daniel Patrón Gómez. Todos los derechos reservados.
    </p>
    
    <div class="footer-links">
      <a href="#header" class="top-link">
        Subir arriba <i class="fa-solid fa-arrow-up"></i>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: var(--bg-main);
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding: 32px 24px;
    font-size: 0.85rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 900px;
  }

  .copyright-text {
    color: var(--text-muted);
  }

  .top-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    transition: var(--transition);
  }

  .top-link:hover {
    color: var(--text-display);
  }

  @media (max-width: 600px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
