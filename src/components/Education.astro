---
const studies = [
  {
    name: "Técnico Superior en Desarrollo de Aplicaciones Multiplataforma (DAM)",
    date: "2017 - 2020",
    info: "I.E.S. Brianda de Mendoza",
    badge: "Grado Superior",
    highlight: true,
    icon: "fa-graduation-cap"
  },
  {
    name: "Administración y Programación en Sistemas ERP-CRM",
    date: "2019",
    info: "Ayla Diseño y Tecnología",
    badge: "Especialización",
    highlight: false,
    icon: "fa-laptop-code"
  },
  {
    name: "Técnico en Sistemas Microinformáticos y Redes (SMR)",
    date: "2015 - 2017",
    info: "I.E.S. Brianda de Mendoza",
    badge: "Grado Medio",
    highlight: false,
    icon: "fa-server"
  },
];
---

<section id="education">
  <div class="container">
    <h2 class="section-title">Formación Académica</h2>
    <div class="section-divider"></div>

    <div class="education-grid">
      {studies.map((item) => (
        <div class={`education-card ${item.highlight ? 'highlight-card' : ''}`}>
          <div class="edu-icon-box">
            <i class={`fa-solid ${item.icon}`}></i>
          </div>

          <div class="edu-body">
            <div class="edu-header">
              <span class="edu-badge">{item.badge}</span>
              <span class="edu-date">
                <i class="fa-regular fa-calendar"></i> {item.date}
              </span>
            </div>
            <h3 class="edu-title">{item.name}</h3>
            <p class="edu-institution">
              <i class="fa-solid fa-building-columns"></i> {item.info}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .education-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }

  .education-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--card-border);
    padding: 24px 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: flex-start;
    gap: 20px;
    transition: var(--transition);
  }

  .education-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(221, 157, 20, 0.4);
  }

  .highlight-card {
    border-left: 4px solid var(--primary);
    background: linear-gradient(135deg, #ffffff 0%, #fffdf8 100%);
  }

  .edu-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .highlight-card .edu-icon-box {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(221, 157, 20, 0.3);
  }

  .edu-body {
    flex: 1;
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .edu-badge {
    background: #f1f5f9;
    color: var(--navy-accent);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .highlight-card .edu-badge {
    background: var(--primary-light);
    color: var(--primary-hover);
  }

  .edu-date {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .edu-title {
    font-size: 1.15rem;
    color: var(--navy-accent);
    margin-bottom: 6px;
    font-weight: 700;
  }

  .edu-institution {
    font-size: 0.95rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 600px) {
    .education-card {
      padding: 18px 20px;
      gap: 14px;
    }
  }
</style>

