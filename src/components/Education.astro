---
import { localized, useTranslations } from '../i18n';

const { lang, t } = useTranslations(Astro.currentLocale);

const studies = [
  {
    name: localized(
      "Técnico Superior en Desarrollo de Aplicaciones Multiplataforma (DAM)",
      "Higher Technician in Multiplatform Application Development (DAM)"
    ),
    date: "2017 - 2020",
    info: "I.E.S. Brianda de Mendoza",
    badge: localized("Grado Superior", "Higher Vocational Degree"),
    highlight: true
  },
  {
    name: localized(
      "Administración y Programación en Sistemas ERP-CRM",
      "Administration and Programming of ERP-CRM Systems"
    ),
    date: "2019",
    info: "Ayla Diseño y Tecnología",
    badge: localized("Especialización", "Specialization"),
    highlight: false
  },
  {
    name: localized(
      "Técnico en Sistemas Microinformáticos y Redes (SMR)",
      "Technician in Microcomputer Systems and Networks (SMR)"
    ),
    date: "2015 - 2017",
    info: "I.E.S. Brianda de Mendoza",
    badge: localized("Grado Medio", "Intermediate Vocational Degree"),
    highlight: false
  },
];
---

<section id="education">
  <div class="container">
    <div class="section-tag">
      <i class="fa-solid fa-graduation-cap text-muted"></i> {t('education.label')}
    </div>
    <h2 class="section-title">{t('education.title')}</h2>
    <div class="section-divider"></div>

    <div class="edu-list">
      {studies.map((item) => (
        <div class={`edu-card ${item.highlight ? 'highlight-card' : ''}`}>
          <div class="edu-top">
            <div class="edu-title">{item.name[lang]}</div>
            <div class="edu-date">{item.date}</div>
          </div>

          <div class="edu-bottom">
            <div class="edu-inst">
              <i class="fa-solid fa-building-columns inst-ic"></i>
              <span>{item.info}</span>
            </div>
            <div class="edu-badge">{item.badge[lang]}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .edu-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: var(--transition);
  }

  .edu-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface);
  }

  .highlight-card {
    border-left: 3px solid var(--accent);
  }

  .edu-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
  }

  .edu-title {
    display: block !important;
    font-size: 1.05rem;
    color: var(--text-display);
    font-weight: 600;
    line-height: 1.3;
    flex: 1;
    min-width: 240px;
  }

  .edu-date {
    display: block !important;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .edu-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .edu-inst {
    display: flex !important;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .inst-ic {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .edu-badge {
    display: inline-block !important;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }
</style>
