---
const studies = [
  {
    name: "Desarrollo de Aplicaciones Multiplataforma - Ciclo Formativo de Grado Superior",
    date: "2017 - 2020",
    info: "I.E.S. Brianda de Mendoza",
    badge: "Grado Superior",
    icon: "fa-graduation-cap"
  },
  {
    name: "Administración y Programación en Sistemas ERP-CRM",
    date: "2019 - 2019",
    info: "Ayla Diseño y Tecnología",
    badge: "Especialización",
    icon: "fa-laptop-code"
  },
  {
    name: "Sistemas Microinformáticos y Redes - Ciclo Formativo de Grado Medio",
    date: "2015 - 2017",
    info: "I.E.S. Brianda de Mendoza",
    badge: "Grado Medio",
    icon: "fa-server"
  },
];
---

<section id="education">
  <div class="container">
    <h2 class="section-title">Formación</h2>
    <div class="section-divider"></div>

    <div class="timeline-container">
      {studies.map((item, index) => (
        <div class={`timeline-item ${index % 2 === 0 ? 'left' : 'right'}`}>
          <div class="timeline-dot">
            <i class={`fa-solid ${item.icon}`}></i>
          </div>
          <div class="timeline-card">
            <div class="card-header-flex">
              <span class="timeline-badge">{item.badge}</span>
              <span class="timeline-date">
                <i class="fa-regular fa-calendar"></i> {item.date}
              </span>
            </div>
            <h3 class="timeline-title">{item.name}</h3>
            <p class="timeline-institution">
              <i class="fa-solid fa-school"></i> {item.info}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-container {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: 20px 0;
  }

  /* Central line */
  .timeline-container::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    background: var(--primary-light);
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 40px;
    width: 50%;
  }

  .timeline-item.left {
    left: 0;
    padding-right: 40px;
  }

  .timeline-item.right {
    left: 50%;
    padding-left: 40px;
  }

  .timeline-dot {
    position: absolute;
    top: 15px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    box-shadow: 0 0 0 6px #ffffff, var(--shadow-md);
    z-index: 2;
  }

  .timeline-item.left .timeline-dot {
    right: -22px;
  }

  .timeline-item.right .timeline-dot {
    left: -22px;
  }

  .timeline-card {
    background: #ffffff;
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .timeline-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .card-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .timeline-badge {
    background: var(--primary-light);
    color: var(--primary-hover);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .timeline-date {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .timeline-title {
    font-size: 1.15rem;
    color: var(--navy-accent);
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .timeline-institution {
    font-size: 0.95rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .timeline-container::before {
      left: 20px;
    }

    .timeline-item {
      width: 100%;
      padding-left: 60px !important;
      padding-right: 0 !important;
    }

    .timeline-item.right {
      left: 0;
    }

    .timeline-dot {
      left: 0 !important;
    }
  }
</style>
