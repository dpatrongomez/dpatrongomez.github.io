---
import { Image } from "astro:assets";
import { Icon } from 'astro-icon/components';
import { projects } from "../lib/projects";

function getTagData(tag: string) {
  const lower = tag.toLowerCase();
  if (lower.includes("flutter")) return { icon: "fa6-brands:flutter" };
  if (lower.includes("dart")) return { icon: "fa6-brands:dart-lang" };
  if (lower.includes("android")) return { icon: "fa6-brands:android" };
  if (lower.includes("angular")) return { icon: "fa6-brands:angular" };
  if (lower.includes("firebase")) return { icon: "devicon-plain:firebase" };
  if (lower.includes("github") || lower.includes("action")) return { icon: "devicon-plain:githubactions" };
  if (lower.includes("rest") || lower.includes("api")) return { icon: "fa6-solid:network-wired" };
  if (lower.includes("map")) return { icon: "fa6-solid:map-location-dot" };
  if (lower.includes("web")) return { icon: "fa6-solid:globe" };
  return { icon: "fa6-solid:tag" };
}
---

<section id="portfolio">
  <div class="container">
    <div class="section-tag">
      <Icon name="fa6-solid:folder-open" class="text-muted" /> PROYECTOS
    </div>
    <h2 class="section-title">Proyectos Destacados & Apps</h2>
    <div class="section-divider"></div>

    <div class="grid-3">
      {projects.map((project) => (
        <div class="project-card">
          <div class="card-media">
            <Image src={project.image} alt={project.name} format="webp" width={256} loading="lazy" class="media-img" />
            {project.featured && (
              <span class="badge-feat">Destacado</span>
            )}
          </div>

          <div class="card-main">
            <div class="card-header">
              <h3 class="project-title">
                {project.web ? (
                  <a href={project.web} target="_blank" rel="noopener noreferrer" class="title-link">
                    {project.name}
                    <Icon name="fa6-solid:arrow-up-right-from-square" class="title-ic" />
                  </a>
                ) : (
                  <span>{project.name}</span>
                )}
              </h3>
            </div>

            <p class="project-info">{project.info}</p>

            <div class="tags-flex">
              {project.tags.map((tag) => {
                const data = getTagData(tag);
                return (
                  <span class="mono-tag tag-with-icon">
                    <Icon name={data.icon} class="tag-ic" />
                    {tag}
                  </span>
                );
              })}
            </div>

            <div class="card-footer">
              {project.web && (
                <a 
                  href={project.web} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-project btn-primary-action"
                >
                  <Icon name={project.googleplay ? "fa6-brands:google-play" : "fa6-solid:globe"} class="btn-ic" />
                  <span>{project.googleplay ? "Google Play" : "Ver Web"}</span>
                </a>
              )}
              {project.archived && (
                <div class="archived-tag">
                  <Icon name="fa6-solid:box-archive" class="btn-ic" />
                  <span>Archivada</span>
                </div>
              )}
              <a 
                href={project.github} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-project btn-secondary-action"
              >
                <Icon name="fa6-brands:github" class="btn-ic" />
                <span>Código</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
  }

  .project-card:hover {
    border-color: var(--border-hover);
  }

  .card-media {
    position: relative;
    height: 130px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow: hidden;
  }

  .media-img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
    transition: transform 0.2s ease;
  }

  .project-card:hover .media-img {
    transform: scale(1.05);
  }

  .badge-feat {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--accent-subtle);
    color: var(--accent-hover);
    border: 1px solid var(--accent-border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .card-main {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-title {
    font-size: 1.1rem;
    color: var(--text-display);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .title-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-display);
  }

  .title-link:hover {
    color: var(--accent-hover);
  }

  .title-ic {
    font-size: 0.72rem;
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .title-link:hover .title-ic {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  .project-info {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .tags-flex {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .mono-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--bg-pill);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .tag-with-icon {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tag-ic {
    font-size: 0.75rem;
    color: var(--accent-hover);
  }

  .card-footer {
    display: flex;
    gap: 10px;
    margin-top: auto;
    align-items: center;
  }

  .btn-project {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    flex: 1 1 0%;
    min-width: 0;
    box-sizing: border-box;
    transition: var(--transition);
    cursor: pointer;
  }

  .btn-ic {
    display: inline-block;
    margin-right: 6px;
    font-size: 0.88rem;
    flex-shrink: 0;
  }

  .btn-primary-action {
    background: var(--text-display);
    color: var(--bg-main);
    border: 1px solid var(--text-display);
    font-weight: 600;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .btn-primary-action:hover {
    background: #e4e4e7;
    border-color: #e4e4e7;
    color: #000000;
  }

  .btn-secondary-action {
    background: var(--bg-pill);
    color: var(--text-primary);
    border: 1px solid var(--border-hover);
  }

  .btn-secondary-action:hover {
    background: var(--border);
    border-color: var(--border-focus);
    color: var(--text-display);
  }

  .btn-project span {
    white-space: nowrap;
    display: inline-block;
  }

  .archived-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    background: var(--bg-surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-disabled);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    white-space: nowrap;
    flex: 1 1 0%;
    min-width: 0;
    box-sizing: border-box;
  }
</style>
