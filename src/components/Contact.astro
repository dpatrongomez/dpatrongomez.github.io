---
const socialLinks = [
  {
    name: "LinkedIn",
    detail: "in/dpatrongomez",
    url: "https://www.linkedin.com/in/dpatrongomez/",
    icon: "fa-brands fa-linkedin"
  },
  {
    name: "GitHub",
    detail: "@dpatrongomez",
    url: "https://github.com/dpatrongomez",
    icon: "fa-brands fa-github"
  },
  {
    name: "Email",
    detail: "dpatrongomez@gmail.com",
    url: "mailto:dpatrongomez@gmail.com",
    icon: "fa-solid fa-envelope"
  },
  {
    name: "Telegram",
    detail: "@dpatrongomez",
    url: "https://t.me/dpatrongomez",
    icon: "fa-brands fa-telegram"
  },
];
---

<section id="contact">
  <div class="container">
    <div class="contact-box">
      <div class="section-tag">
        <i class="fa-solid fa-envelope text-muted"></i> CONTACTO
      </div>
      <h2 class="section-title">¿Hablamos?</h2>
      <div class="section-divider"></div>
      
      <p class="contact-subtitle">
        Si tienes alguna propuesta laboral, consulta o quieres colaborar en algún proyecto, no dudes en escribirme.
      </p>

      <div class="contact-grid">
        {socialLinks.map((social) => (
          <a 
            href={social.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="contact-card"
          >
            <div class="card-left">
              <div class="card-ic-wrapper">
                <i class={`${social.icon} card-ic`}></i>
              </div>
              <div class="card-text">
                <div class="card-name">{social.name}</div>
                <div class="card-detail">{social.detail}</div>
              </div>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square arrow-ic"></i>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-box {
    max-width: 850px;
  }

  .contact-subtitle {
    color: var(--text-muted);
    font-size: 1.02rem;
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    transition: var(--transition);
  }

  .contact-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface);
  }

  .card-left {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .card-ic-wrapper {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-ic {
    font-size: 1.1rem;
    color: var(--text-display);
    transition: var(--transition);
  }

  .contact-card:hover .card-ic {
    color: var(--accent);
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .card-name {
    display: block !important;
    font-size: 0.98rem;
    color: var(--text-display);
    font-weight: 600;
    line-height: 1.3;
  }

  .card-detail {
    display: block !important;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow-ic {
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: var(--transition);
  }

  .contact-card:hover .arrow-ic {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
</style>
