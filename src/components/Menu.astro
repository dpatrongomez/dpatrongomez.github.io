---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, locales, useTranslations } from '../i18n';

const { lang, t } = useTranslations(Astro.currentLocale);

const menuItems = [
  { label: t('nav.about'), url: "#about" },
  { label: t('nav.experience'), url: "#experience" },
  { label: t('nav.skills'), url: "#skills" },
  { label: t('nav.tokens'), url: "#tokens" },
  { label: t('nav.education'), url: "#education" },
  { label: t('nav.projects'), url: "#portfolio" },
  { label: t('nav.contact'), url: "#contact" },
];

const languageOptions = locales.map((code) => ({
  code,
  name: languages[code].name,
  href: getRelativeLocaleUrl(code, ''),
  active: code === lang,
}));
---

<header class="navbar-wrapper">
  <nav class="navbar-container">
    <a href="#header" class="navbar-brand" aria-label={t('nav.home')}>
      <span class="brand-name">dpatrongomez</span>
      <span class="brand-badge">dev</span>
    </a>

    <button id="menu-toggle" class="mobile-toggle" aria-label={t('nav.toggle')}>
      <i class="fa-solid fa-bars icon-open"></i>
      <i class="fa-solid fa-xmark icon-close hidden"></i>
    </button>

    <ul id="navbar-menu" class="nav-links">
      {menuItems.map((item) => (
        <li>
          <a href={item.url} class="nav-link">
            {item.label}
          </a>
        </li>
      ))}
      <li class="lang-switch" role="group" aria-label={t('lang.label')}>
        {languageOptions.map((option) =>
          option.active ? (
            <span class="lang-option is-active" aria-current="true" title={option.name}>
              {option.code.toUpperCase()}
            </span>
          ) : (
            <a href={option.href} class="lang-option" hreflang={option.code} lang={option.code} title={option.name}>
              {option.code.toUpperCase()}
            </a>
          ),
        )}
      </li>
    </ul>
  </nav>
</header>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .navbar-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-display);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .brand-name {
    color: var(--text-display);
  }

  .brand-badge {
    font-size: 0.68rem;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }

  .navbar-brand:hover .brand-name {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .nav-link {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    transition: var(--transition);
  }

  .nav-link:hover {
    color: var(--text-display);
  }

  .lang-switch {
    display: flex;
    gap: 4px;
  }

  .lang-option {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px 7px;
    transition: var(--transition);
  }

  a.lang-option:hover {
    color: var(--text-display);
    border-color: var(--border-hover);
  }

  .lang-option.is-active {
    color: var(--accent-hover);
    background: var(--accent-subtle);
    border-color: var(--accent-subtle);
  }

  .mobile-toggle {
    display: none;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    color: var(--text-display);
    cursor: pointer;
    padding: 6px 10px;
    transition: var(--transition);
  }

  .mobile-toggle:hover {
    border-color: var(--border-hover);
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: block;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg-main);
      flex-direction: column;
      padding: 16px 24px;
      gap: 12px;
      border-bottom: 1px solid var(--border);
      display: none;
      align-items: flex-start;
    }

    .nav-links.active {
      display: flex;
    }

    .nav-link {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const navMenu = document.getElementById('navbar-menu');
  const iconOpen = toggleBtn?.querySelector('.icon-open');
  const iconClose = toggleBtn?.querySelector('.icon-close');

  toggleBtn?.addEventListener('click', () => {
    navMenu?.classList.toggle('active');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Close menu when clicking link on mobile
  navMenu?.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      navMenu.classList.remove('active');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
